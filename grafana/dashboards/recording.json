{
  "uid": "acl-recording",
  "title": "Recording",
  "description": "Big-number view for the demo video (open with ?kiosk&theme=dark; var-session_id=<id> focuses one session).",
  "tags": [
    "acl"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "links": [],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      },
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      },
      {
        "type": "textbox",
        "name": "session_id",
        "label": "Session id",
        "description": "A session_id from the audit log (see Recent sessions, or click a session on the Threats dashboard).",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Policy changes",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"ok\"",
        "target": {
          "refId": "Anno",
          "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"ok\"",
          "queryType": "range"
        },
        "titleFormat": "Policy reloaded",
        "textFormat": "{{previous_revision}} -> {{revision}}",
        "tagKeys": "result",
        "instant": false
      },
      {
        "name": "Rejected policy edits",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"invalid\"",
        "target": {
          "refId": "Anno",
          "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"invalid\"",
          "queryType": "range"
        },
        "titleFormat": "Policy edit rejected",
        "textFormat": "{{previous_revision}} -> {{revision}}",
        "tagKeys": "result",
        "instant": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Session risk",
      "description": "The session's current risk (latest audit entry); with no session_id, the riskiest session in the time range. 0.5: write needs approval or the agent is throttled; 0.8: tools frozen.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(1, last_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", risk=\"risk\" | session_id=~\"$session_id.*\" | session_id != \"\" | risk != \"\" | unwrap risk | __error__=\"\" [$__range]) by (session_id))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 2,
          "min": 0.0,
          "max": 1.0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "transformations": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Session marked compromised",
      "description": "Untrusted content reached the session (taint). It lasts until the session ends; write, delete and egress are removed or held.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", taint=\"taint\" | session_id=~\"$session_id.*\" | session_id != \"\" | taint=\"true\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "YES: COMPROMISED",
                  "color": "red"
                }
              }
            }
          ],
          "links": [],
          "noValue": "NO"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "vertical",
        "wideLayout": true,
        "text": {
          "valueSize": 44,
          "titleSize": 16
        }
      },
      "transformations": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Risk over time",
      "description": "Session risk after each call; blue markers are policy reloads.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "max(max_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", risk=\"risk\" | session_id=~\"$session_id.*\" | session_id != \"\" | risk != \"\" | unwrap risk | __error__=\"\" [$__auto]))",
          "editorMode": "code",
          "legendFormat": "risk",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 1,
          "min": 0.0,
          "max": 1.0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.spanNulls",
                "value": true
              },
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "dashed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "transformations": []
    },
    {
      "id": 4,
      "type": "table",
      "title": "Last decisions",
      "description": "The six newest decisions: time, who, action and resource, the verdict and its reason code.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", principal=\"principal\", action=\"action\", resource=\"resource\", reason=\"reason_code\" | session_id=~\"$session_id.*\" | session_id != \"\" | label_format who=`{{ .principal | trimSuffix \"@demo\" | trimPrefix \"svc:\" }}`, call=`{{ .action }} {{ .resource }}`",
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 6
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ts"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time: HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 82
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "who"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 92
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "decision"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 132
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "decision"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "allow": {
                        "color": "green",
                        "index": 0
                      },
                      "redact": {
                        "color": "yellow",
                        "index": 1
                      },
                      "require_approval": {
                        "color": "orange",
                        "index": 2,
                        "text": "approval"
                      },
                      "block": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": false,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "who",
                "call",
                "decision",
                "reason"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "who": 1,
              "call": 2,
              "decision": 3,
              "reason": 4
            },
            "renameByName": {
              "Time": "ts"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "risk",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "ts",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "",
      "description": "Calls blocked in the last 5 minutes, and operations waiting for a human approval right now.",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(acl_requests_total{decision=\"block\"}[5m]))) or vector(0)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(acl_approvals_pending) or vector(0)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Blocked (5 min)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#2a2d35",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1.0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Approvals waiting"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#2a2d35",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1.0
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "wideLayout": true,
        "text": {
          "valueSize": 40,
          "titleSize": 16
        }
      },
      "transformations": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "",
      "description": "Last 5 minutes: decided calls, redacted calls, and the time the gateway's checks took per call (95th percentile), split into rule checks (deterministic controls, including sql_guard's query-plan lookup and egress's DNS check) and AI checks (injection classifier and LLM judges, only on calls where they ran). From each call's audit entry (latency_ms.controls).",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(acl_requests_total[5m]))) or vector(0)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(acl_requests_total{decision=\"redact\"}[5m]))) or vector(0)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {job=\"acl\", decision=~\".+\"} | json c0=\"latency_ms.controls.authn\", c1=\"latency_ms.controls.authz\", c2=\"latency_ms.controls.model_allowlist\", c3=\"latency_ms.controls.pii\", c4=\"latency_ms.controls.secrets\", c5=\"latency_ms.controls.sql_guard\", c6=\"latency_ms.controls.egress\", c7=\"latency_ms.controls.signatures\", c8=\"latency_ms.controls.tool_pinning\", c9=\"latency_ms.controls.budget\", c10=\"latency_ms.controls.loop_detect\" | label_format ms=`{{ addf .c0 .c1 .c2 .c3 .c4 .c5 .c6 .c7 .c8 .c9 .c10 }}` | unwrap ms | __error__=\"\" [5m]) by ()",
          "editorMode": "code",
          "queryType": "instant"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {job=\"acl\", decision=~\".+\"} | json c0=\"latency_ms.controls.prompt_injection\", c1=\"latency_ms.controls.tool_poisoning\", c2=\"latency_ms.controls.intent_judge\", c3=\"latency_ms.controls.output_policy\" | label_format ms=`{{ addf .c0 .c1 .c2 .c3 }}` | ms != \"0\" | unwrap ms | __error__=\"\" [5m]) by ()",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 0,
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Requests"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Redacted"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "yellow",
                      "value": null
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rule checks p95 (live)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "AI checks p95 (live)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "purple",
                      "value": null
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
