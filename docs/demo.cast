[0.000, "o", "    \u001b[32m[PASS] report write before the page: ok\u001b[0m\r\n"]
[0.000, "o", "       \u001b[2meffective scope: read:db:sales.*, read:web:*, write:fs:reports/*, generate:model:*\u001b[0m\r\n"]
