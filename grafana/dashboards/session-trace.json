{
  "uid": "acl-session-trace",
  "title": "Session trace",
  "description": "One session ($session_id): every decision, its effective permissions and the risk score over time, from the audit log.",
  "tags": [
    "acl"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "acl"
      ],
      "title": "AI Control Layer",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      },
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      },
      {
        "type": "textbox",
        "name": "session_id",
        "label": "Session id",
        "description": "A session_id from the audit log (see Recent sessions, or click a session on the Threats dashboard).",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Policy changes",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"ok\"",
        "target": {
          "refId": "Anno",
          "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"ok\"",
          "queryType": "range"
        },
        "titleFormat": "Policy reloaded",
        "textFormat": "{{previous_revision}} -> {{revision}}",
        "tagKeys": "result",
        "instant": false
      },
      {
        "name": "Rejected policy edits",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"invalid\"",
        "target": {
          "refId": "Anno",
          "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"invalid\"",
          "queryType": "range"
        },
        "titleFormat": "Policy edit rejected",
        "textFormat": "{{previous_revision}} -> {{revision}}",
        "tagKeys": "result",
        "instant": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Calls",
      "description": "Decisions recorded for this session in the time range.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\" | session_id=\"$session_id\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "transformations": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Blocked",
      "description": "Blocked calls of this session.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\" | session_id=\"$session_id\" | decision=\"block\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "transformations": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peak risk",
      "description": "Highest session risk recorded (decays with risk.half_life_s).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "max(max_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", risk=\"risk\" | session_id=\"$session_id\" | risk != \"\" | unwrap risk | __error__=\"\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 2,
          "min": 0.0,
          "max": 1.0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "transformations": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taint",
      "description": "Tainted once untrusted content reached the session; never cleared until the session ends.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", taint=\"taint\" | session_id=\"$session_id\" | taint=\"true\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "tainted"
                }
              }
            }
          ],
          "links": [],
          "noValue": "clean"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "transformations": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent sessions",
      "description": "Sessions with decisions in the time range; click an id to trace it.",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(20, sum by (session_id, principal, actor) (count_over_time({job=\"acl\", decision=~\".+\"} | json session_id=\"session_id\", principal=\"principal\" | session_id != \"\" [$__range])))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "principal"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "calls"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Trace this session",
                    "url": "/d/acl-session-trace/session-trace?var-session_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^Value.*$",
            "renamePattern": "calls"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "session_id",
                "principal",
                "actor",
                "calls"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "session_id": 0,
              "principal": 1,
              "actor": 2,
              "calls": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "calls",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Risk over time",
      "description": "Session risk after each call (the audit entry's `risk`).",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "max(max_over_time({job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", risk=\"risk\" | session_id=\"$session_id\" | risk != \"\" | unwrap risk | __error__=\"\" [$__auto]))",
          "editorMode": "code",
          "legendFormat": "risk",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 2,
          "min": 0.0,
          "max": 1.0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.spanNulls",
                "value": true
              },
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "line+area"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "transformations": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "Timeline",
      "description": "Every decision of the session, newest first: what was asked, the verdict and reason, the effective scope after session restrictions, risk, taint and the policy revision that decided it.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", action=\"action\", resource=\"resource\", reason_code=\"reason_code\", effective_scope=\"effective_scope\", risk=\"risk\", taint=\"taint\", policy_revision=\"policy_revision\" | session_id=\"$session_id\"",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "decision"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "allow": {
                        "color": "green",
                        "index": 0
                      },
                      "redact": {
                        "color": "yellow",
                        "index": 1
                      },
                      "require_approval": {
                        "color": "orange",
                        "index": 2
                      },
                      "block": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "effective_scope"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 440
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "channel",
                "decision",
                "action",
                "resource",
                "reason_code",
                "effective_scope",
                "risk",
                "taint",
                "policy_revision"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "channel": 1,
              "decision": 2,
              "action": 3,
              "resource": 4,
              "reason_code": 5,
              "effective_scope": 6,
              "risk": 7,
              "taint": 8,
              "policy_revision": 9
            },
            "renameByName": {
              "Time": "ts"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "risk",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "ts",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Effective scope changes",
      "description": "The permissions left to the session at each call; taint and risk rules remove actions or attach obligations.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{job=\"acl\", decision=~\".+\"} |= \"$session_id\" | json session_id=\"session_id\", action=\"action\", effective_scope=\"effective_scope\", taint=\"taint\", risk=\"risk\" | session_id=\"$session_id\"",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "effective_scope"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 440
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "decision",
                "action",
                "effective_scope",
                "taint",
                "risk"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "decision": 1,
              "action": 2,
              "effective_scope": 3,
              "taint": 4,
              "risk": 5
            },
            "renameByName": {
              "Time": "ts"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "risk",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "ts",
                "desc": true
              }
            ]
          }
        }
      ]
    }
  ]
}
