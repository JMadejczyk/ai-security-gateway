# Copy to `.env` (gitignored) and replace every value before `docker compose up`.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Gateway only: signs and verifies agent/operator JWTs. Never given to the agent container.
ACL_JWT_SECRET=change-me-at-least-32-bytes-of-random-data

# Gateway and mcp-postgres only: signs the X-ACL-Principal assertion (min. 32 bytes).
ACL_INTERNAL_KEY=change-me-another-32-bytes-of-random-data

# Postgres superuser (postgres container only) and the RLS-bound application role (acl_app),
# used by mcp-postgres.
POSTGRES_PASSWORD=change-me-postgres-superuser
ACL_APP_DB_PASSWORD=change-me-acl-app

# Redis on the `state` network (redis and gateway only): `requirepass` for budget counters,
# session state, loop counters, approvals and the kill switch.
ACL_REDIS_PASSWORD=change-me-redis-password

# Model pulled by `docker compose --profile init run --rm ollama-init`.
OLLAMA_MODEL=qwen3:8b

# Host ports of the gateway's two published listeners (always bound to 127.0.0.1).
# ACL_OPERATOR_HOST_PORT=9090
# ACL_AGENT_HOST_PORT=8080
