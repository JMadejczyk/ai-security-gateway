{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "acl"
  ],
  "model": "acl/{env:ACL_OPENCODE_MODEL}",
  "small_model": "acl/{env:ACL_OPENCODE_MODEL}",
  "default_agent": "databot",
  "agent": {
    "databot": {
      "mode": "primary",
      "description": "The sales team's data assistant: every tool goes through the AI gateway",
      "prompt": "{file:./databot-prompt.md}",
      "temperature": 0
    },
    "title": {
      "disable": true
    }
  },
  "provider": {
    "acl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Control Layer",
      "options": {
        "baseURL": "{env:ACL_GATEWAY_URL}/v1",
        "apiKey": "{env:ACL_OPENCODE_TOKEN}",
        "timeout": 180000
      },
      "models": {
        "{env:ACL_OPENCODE_MODEL}": {
          "name": "{env:ACL_OPENCODE_MODEL} (through the gateway)",
          "tool_call": true,
          "reasoning": false,
          "temperature": true,
          "limit": {
            "context": 128000,
            "output": 2048
          },
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    }
  },
  "mcp": {
    "sales_db": {
      "type": "remote",
      "url": "{env:ACL_GATEWAY_URL}/mcp/sales_db",
      "headers": {
        "Authorization": "Bearer {env:ACL_OPENCODE_TOKEN}"
      },
      "oauth": false
    },
    "web": {
      "type": "remote",
      "url": "{env:ACL_GATEWAY_URL}/mcp/web",
      "headers": {
        "Authorization": "Bearer {env:ACL_OPENCODE_TOKEN}"
      },
      "oauth": false
    },
    "reports": {
      "type": "remote",
      "url": "{env:ACL_GATEWAY_URL}/mcp/reports",
      "headers": {
        "Authorization": "Bearer {env:ACL_OPENCODE_TOKEN}"
      },
      "oauth": false
    }
  },
  "tools": {
    "bash": false,
    "edit": false,
    "write": false,
    "patch": false,
    "read": false,
    "list": false,
    "glob": false,
    "grep": false,
    "webfetch": false,
    "websearch": false,
    "codesearch": false,
    "task": false,
    "todowrite": false,
    "todoread": false,
    "skill": false,
    "lsp": false
  }
}
