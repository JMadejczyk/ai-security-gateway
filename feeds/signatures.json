      "pattern": "(?i)<\\s*IMPORTANT\\s*>|\\b(?:do\\s+not|don't|never)\\s+(?:mention|tell|reveal|show)\\b[^.\\n]{0,60}?\\b(?:user|human)\\b",
      "severity": "critical",
      "channels": ["mcp", "llm"]
    },
    {
