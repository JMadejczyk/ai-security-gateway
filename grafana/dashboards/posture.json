{
  "uid": "acl-posture",
  "title": "Posture",
  "description": "Management view: how much traffic is decided which way, what threatens it, what it costs and how close each user and agent is to its budget.",
  "tags": [
    "acl"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "acl"
      ],
      "title": "AI Control Layer",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      },
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Policy changes",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"ok\"",
        "target": {
          "refId": "Anno",
          "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"ok\"",
          "queryType": "range"
        },
        "titleFormat": "Policy reloaded",
        "textFormat": "{{previous_revision}} -> {{revision}}",
        "tagKeys": "result",
        "instant": false
      },
      {
        "name": "Rejected policy edits",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"invalid\"",
        "target": {
          "refId": "Anno",
          "expr": "{job=\"acl\", event=\"policy_reload\"} | json result=\"result\", revision=\"revision\", previous_revision=\"previous_revision\" | result=\"invalid\"",
          "queryType": "range"
        },
        "titleFormat": "Policy edit rejected",
        "textFormat": "{{previous_revision}} -> {{revision}}",
        "tagKeys": "result",
        "instant": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Decisions",
      "description": "Calls the gateway decided in the time range (LLM and MCP).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(acl_requests_total[$__range])) or vector(0)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "transformations": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Block rate",
      "description": "Share of decided calls that were blocked.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(acl_requests_total{decision=\"block\"}[$__range])) or vector(0)) / clamp_min(sum(increase(acl_requests_total[$__range])), 1)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "mappings": [],
          "links": [],
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "transformations": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Held for approval",
